generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TeamRole {
  facilitator
  member
}

enum RetroStatus {
  comments
  grouping
  voting
  actions
  roti
  closed
}

enum ActionStatus {
  pending
  doing
  done
  unmet
}

model User {
  id             String            @id @default(cuid())
  email          String            @unique
  passwordHash   String
  name           String
  avatarId       String?
  isAdmin        Boolean           @default(false)
  createdAt      DateTime          @default(now())
  memberships    TeamMember[]
  participants   Participant[]
  ownedActions     ActionItem[]      @relation("ActionOwner")
  createdActions   ActionItem[]      @relation("ActionCreator")
  createdTemplates Template[]        @relation("TemplateCreator")
  joinRequests     TeamJoinRequest[]
  invitesSent      TeamInvite[]      @relation("TeamInvitesSent")
  invitesReceived  TeamInvite[]      @relation("TeamInvitesReceived")
}

model Team {
  id             String            @id @default(cuid())
  name           String
  logoUrl        String?
  inviteCode     String            @unique @default(cuid())
  createdAt      DateTime          @default(now())
  members        TeamMember[]
  retrospectives Retrospective[]
  actionItems    ActionItem[]
  joinRequests   TeamJoinRequest[]
  invites        TeamInvite[]
}

model TeamMember {
  id          String    @id @default(cuid())
  teamId      String
  userId      String
  role        TeamRole  @default(member)
  favoritedAt DateTime?
  team        Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
}

model TeamJoinRequest {
  id        String   @id @default(cuid())
  teamId    String
  userId    String
  createdAt DateTime @default(now())
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
}

enum TeamInviteStatus {
  pending
  accepted
  rejected
}

model TeamInvite {
  id        String           @id @default(cuid())
  teamId    String
  inviterId String
  inviteeId String
  status    TeamInviteStatus @default(pending)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  team      Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  inviter   User             @relation("TeamInvitesSent", fields: [inviterId], references: [id], onDelete: Cascade)
  invitee   User             @relation("TeamInvitesReceived", fields: [inviteeId], references: [id], onDelete: Cascade)

  @@unique([teamId, inviteeId])
  @@index([inviteeId, status])
}

model Template {
  id                          String           @id @default(cuid())
  name                        String
  description                 String?
  maxCommentsPerParticipant   Int?
  votesPerParticipant         Int              @default(5)
  maxVotesPerCard             Int              @default(2)
  backgroundColor             String?
  backgroundImageUrl          String?
  isGlobal                    Boolean          @default(false)
  createdById                 String?
  columns                     TemplateColumn[]
  retrospectives              Retrospective[]
  createdBy                   User?            @relation("TemplateCreator", fields: [createdById], references: [id], onDelete: SetNull)
}

model TemplateColumn {
  id          String   @id @default(cuid())
  templateId  String
  title       String
  description String?
  icon        String?
  logoUrl     String?
  position    Int
  template    Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
}

model Retrospective {
  id                        String         @id @default(cuid())
  teamId                    String
  templateId                String
  title                     String
  status                    RetroStatus    @default(comments)
  guestInviteCode           String         @unique @default(cuid())
  memberInviteCode          String         @unique @default(cuid())
  maxCommentsPerParticipant Int?
  votesPerParticipant       Int            @default(5)
  maxVotesPerCard           Int            @default(2)
  allowAnonymous            Boolean        @default(true)
  allowCrossColumnGrouping  Boolean        @default(false)
  timerSeconds              Int?
  timerEndsAt               DateTime?
  timerPausedRemaining      Int?
  backgroundColor           String?
  backgroundImageUrl        String?
  presenterCardId           String?
  createdAt                 DateTime       @default(now())
  closedAt                  DateTime?
  team                      Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  template                  Template       @relation(fields: [templateId], references: [id])
  columns                   RetroColumn[]
  participants              Participant[]
  cards                     Card[]
  groups                    CardGroup[]
  votes                     Vote[]
  actionItems               ActionItem[]
  rotiResponses             RotiResponse[]
}

model RetroColumn {
  id          String        @id @default(cuid())
  retroId     String
  title       String
  description String?
  icon        String?
  logoUrl     String?
  position    Int
  retro       Retrospective @relation(fields: [retroId], references: [id], onDelete: Cascade)
  cards       Card[]
}

model Participant {
  id             String         @id @default(cuid())
  retroId        String
  userId         String?
  guestName      String?
  avatarId       String?
  isGuest        Boolean        @default(false)
  commentsReady  Boolean        @default(false)
  votesReady     Boolean        @default(false)
  retro          Retrospective  @relation(fields: [retroId], references: [id], onDelete: Cascade)
  user           User?          @relation(fields: [userId], references: [id])
  cards          Card[]
  votes          Vote[]
  rotiResponses  RotiResponse[]

  @@index([retroId, userId])
}

model Card {
  id          String        @id @default(cuid())
  retroId     String
  columnId    String
  authorId    String
  content     String        @default("")
  imageUrl    String?
  isAnonymous Boolean       @default(false)
  groupId     String?
  position    Int           @default(0)
  createdAt   DateTime      @default(now())
  retro       Retrospective @relation(fields: [retroId], references: [id], onDelete: Cascade)
  column      RetroColumn   @relation(fields: [columnId], references: [id], onDelete: Cascade)
  author      Participant   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  group       CardGroup?    @relation(fields: [groupId], references: [id], onDelete: SetNull)
  votes       Vote[]
  actionItems ActionItem[]
}

model CardGroup {
  id          String        @id @default(cuid())
  retroId     String
  title       String?
  retro       Retrospective @relation(fields: [retroId], references: [id], onDelete: Cascade)
  cards       Card[]
  votes       Vote[]
  actionItems ActionItem[]
}

model Vote {
  id            String        @id @default(cuid())
  retroId       String
  participantId String
  cardId        String?
  groupId       String?
  count         Int           @default(1)
  retro         Retrospective @relation(fields: [retroId], references: [id], onDelete: Cascade)
  participant   Participant   @relation(fields: [participantId], references: [id], onDelete: Cascade)
  card          Card?         @relation(fields: [cardId], references: [id], onDelete: Cascade)
  group         CardGroup?    @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([participantId, cardId])
  @@unique([participantId, groupId])
}

model ActionItem {
  id          String         @id @default(cuid())
  teamId      String
  retroId     String?
  title       String
  description String?
  status      ActionStatus   @default(pending)
  ownerId     String?
  createdById String?
  dueDate     DateTime?
  cardId      String?
  groupId     String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  team        Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  retro       Retrospective? @relation(fields: [retroId], references: [id], onDelete: SetNull)
  owner       User?          @relation("ActionOwner", fields: [ownerId], references: [id])
  createdBy   User?          @relation("ActionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  card        Card?          @relation(fields: [cardId], references: [id], onDelete: SetNull)
  group       CardGroup?     @relation(fields: [groupId], references: [id], onDelete: SetNull)
}

model RotiResponse {
  id            String        @id @default(cuid())
  retroId       String
  participantId String
  score         Int
  comment       String?
  retro         Retrospective @relation(fields: [retroId], references: [id], onDelete: Cascade)
  participant   Participant   @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([retroId, participantId])
}
