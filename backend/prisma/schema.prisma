generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TeamRole {
  facilitator
  member
}

enum PhaseKind {
  board
  action_plan
  roti
  semaforo
  semaforo_review
}

enum CardContentMode {
  text_and_image
  image_only
  text_only
}

enum OthersVisibility {
  visible
  blurred
  hidden
}

enum VotingMode {
  off
  single
  multi
}

enum CardSort {
  original
  most_voted
  least_voted
  random
}

enum SemaforoValue {
  red
  yellow
  green
}

enum ActionStatus {
  pending
  doing
  done
  unmet
}

enum ActionEntryMode {
  retrospectiva
  weekly
  planning
  refinamiento
  otro
}

model User {
  id               String                 @id @default(cuid())
  email            String                 @unique
  passwordHash     String
  name             String
  avatarId         String?
  isAdmin          Boolean                @default(false)
  createdAt        DateTime               @default(now())
  memberships      TeamMember[]
  participants     Participant[]
  ownedActions     ActionItem[]           @relation("ActionOwner")
  createdActions   ActionItem[]           @relation("ActionCreator")
  createdTemplates Template[]             @relation("TemplateCreator")
  createdPhases    Phase[]                @relation("PhaseCreator")
  progressUpdates  ActionProgressUpdate[] @relation("ActionProgressAuthor")
  joinRequests     TeamJoinRequest[]
  invitesSent      TeamInvite[]           @relation("TeamInvitesSent")
  invitesReceived  TeamInvite[]           @relation("TeamInvitesReceived")
}

model Team {
  id             String            @id @default(cuid())
  name           String
  logoUrl        String?
  inviteCode     String            @unique @default(cuid())
  createdAt      DateTime          @default(now())
  members        TeamMember[]
  retrospectives Retrospective[]
  actionItems    ActionItem[]
  joinRequests   TeamJoinRequest[]
  invites        TeamInvite[]
}

model TeamMember {
  id          String    @id @default(cuid())
  teamId      String
  userId      String
  role        TeamRole  @default(member)
  favoritedAt DateTime?
  team        Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
}

model TeamJoinRequest {
  id        String   @id @default(cuid())
  teamId    String
  userId    String
  createdAt DateTime @default(now())
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
}

enum TeamInviteStatus {
  pending
  accepted
  rejected
}

model TeamInvite {
  id        String           @id @default(cuid())
  teamId    String
  inviterId String
  inviteeId String
  status    TeamInviteStatus @default(pending)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  team      Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  inviter   User             @relation("TeamInvitesSent", fields: [inviterId], references: [id], onDelete: Cascade)
  invitee   User             @relation("TeamInvitesReceived", fields: [inviteeId], references: [id], onDelete: Cascade)

  @@unique([teamId, inviteeId])
  @@index([inviteeId, status])
}

model Phase {
  id                       String           @id @default(cuid())
  name                     String
  description              String?
  kind                     PhaseKind        @default(board)
  icon                     String?
  color                    String?
  instructions             String?
  timerSeconds             Int?
  isGlobal                 Boolean          @default(false)
  isSystem                 Boolean          @default(false)
  createdById              String?
  allowCreateCards         Boolean          @default(true)
  cardContent              CardContentMode  @default(text_and_image)
  maxCardsPerParticipant   Int?
  allowEditOwnCards        Boolean          @default(true)
  anonymousCards           Boolean          @default(false)
  othersVisibility         OthersVisibility @default(visible)
  revealOnReady            Boolean          @default(false)
  allowGrouping            Boolean          @default(false)
  allowCrossColumnGrouping Boolean          @default(false)
  voting                   VotingMode       @default(off)
  hideVoteCounts           Boolean          @default(false)
  allowReactions           Boolean          @default(false)
  reactionEmojis           String[]         @default(["👍", "❤️", "🎉", "😮", "😕"])
  /// Ordered [red, yellow, green] display emojis for semaforo / semaforo_review.
  semaforoEmojis           String[]         @default(["🔴", "🟡", "🟢"])
  allowPresentation        Boolean          @default(false)
  allowActionItems         Boolean          @default(false)
  showReadyCheck           Boolean          @default(true)
  defaultSort              CardSort         @default(original)
  createdBy                User?            @relation("PhaseCreator", fields: [createdById], references: [id], onDelete: SetNull)
  templates                TemplatePhase[]
}

model Template {
  id                        String                 @id @default(cuid())
  name                      String
  description               String?
  maxCommentsPerParticipant Int?
  votesPerParticipant       Int                    @default(5)
  maxVotesPerCard           Int                    @default(2)
  backgroundColor           String?
  backgroundImageUrl        String?
  isGlobal                  Boolean                @default(false)
  createdById               String?
  columns                   TemplateColumn[]
  phases                    TemplatePhase[]
  semaforoItems             TemplateSemaforoItem[]
  retrospectives            Retrospective[]
  createdBy                 User?                  @relation("TemplateCreator", fields: [createdById], references: [id], onDelete: SetNull)
}

model TemplateColumn {
  id            String                       @id @default(cuid())
  templateId    String
  title         String
  description   String?
  icon          String?
  logoUrl       String?
  position      Int
  template      Template                     @relation(fields: [templateId], references: [id], onDelete: Cascade)
  hiddenInPhases TemplatePhaseHiddenColumn[]
}

model TemplatePhase {
  id            String                       @id @default(cuid())
  templateId    String
  phaseId       String
  position      Int
  template      Template                     @relation(fields: [templateId], references: [id], onDelete: Cascade)
  phase         Phase                        @relation(fields: [phaseId], references: [id], onDelete: Restrict)
  hiddenColumns TemplatePhaseHiddenColumn[]

  @@unique([templateId, phaseId])
}

model TemplatePhaseHiddenColumn {
  templatePhaseId String
  columnId        String
  templatePhase   TemplatePhase  @relation(fields: [templatePhaseId], references: [id], onDelete: Cascade)
  column          TemplateColumn @relation(fields: [columnId], references: [id], onDelete: Cascade)

  @@id([templatePhaseId, columnId])
}

model TemplateSemaforoItem {
  id          String   @id @default(cuid())
  templateId  String
  title       String
  description String?
  position    Int
  template    Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
}

model Retrospective {
  id                        String              @id @default(cuid())
  teamId                    String
  templateId                String
  title                     String
  currentPhaseId            String?             @unique
  guestInviteCode           String              @unique @default(cuid())
  memberInviteCode          String              @unique @default(cuid())
  maxCommentsPerParticipant Int?
  votesPerParticipant       Int                 @default(5)
  maxVotesPerCard           Int                 @default(2)
  allowAnonymous            Boolean             @default(true)
  allowCrossColumnGrouping  Boolean             @default(false)
  timerSeconds              Int?
  timerEndsAt               DateTime?
  timerPausedRemaining      Int?
  backgroundColor           String?
  backgroundImageUrl        String?
  presenterCardId           String?
  createdAt                 DateTime            @default(now())
  closedAt                  DateTime?
  team                      Team                @relation(fields: [teamId], references: [id], onDelete: Cascade)
  template                  Template            @relation(fields: [templateId], references: [id])
  currentPhase              RetroPhase?         @relation("CurrentPhase", fields: [currentPhaseId], references: [id], onDelete: SetNull)
  columns                   RetroColumn[]
  phases                    RetroPhase[]        @relation("RetroPhases")
  participants              Participant[]
  cards                     Card[]
  groups                    CardGroup[]
  votes                     Vote[]
  reactions                 CardReaction[]
  actionItems               ActionItem[]
  rotiResponses             RotiResponse[]
  semaforoItems             RetroSemaforoItem[]
  semaforoVotes             SemaforoVote[]
}

model RetroPhase {
  id                       String                    @id @default(cuid())
  retroId                  String
  position                 Int
  sourcePhaseId            String?
  name                     String
  description              String?
  kind                     PhaseKind                 @default(board)
  icon                     String?
  color                    String?
  instructions             String?
  timerSeconds             Int?
  allowCreateCards         Boolean                   @default(true)
  cardContent              CardContentMode           @default(text_and_image)
  maxCardsPerParticipant   Int?
  allowEditOwnCards        Boolean                   @default(true)
  anonymousCards           Boolean                   @default(false)
  othersVisibility         OthersVisibility          @default(visible)
  revealOnReady            Boolean                   @default(false)
  allowGrouping            Boolean                   @default(false)
  allowCrossColumnGrouping Boolean                   @default(false)
  voting                   VotingMode                @default(off)
  hideVoteCounts           Boolean                   @default(false)
  allowReactions           Boolean                   @default(false)
  reactionEmojis           String[]                  @default(["👍", "❤️", "🎉", "😮", "😕"])
  /// Ordered [red, yellow, green] display emojis for semaforo / semaforo_review.
  semaforoEmojis           String[]                  @default(["🔴", "🟡", "🟢"])
  allowPresentation        Boolean                   @default(false)
  allowActionItems         Boolean                   @default(false)
  showReadyCheck           Boolean                   @default(true)
  defaultSort              CardSort                  @default(original)
  retro                    Retrospective             @relation("RetroPhases", fields: [retroId], references: [id], onDelete: Cascade)
  currentFor               Retrospective?            @relation("CurrentPhase")
  hiddenColumns            RetroPhaseHiddenColumn[]
  cards                    Card[]

  @@index([retroId, position])
}

model RetroPhaseHiddenColumn {
  retroPhaseId String
  columnId     String
  retroPhase   RetroPhase  @relation(fields: [retroPhaseId], references: [id], onDelete: Cascade)
  column       RetroColumn @relation(fields: [columnId], references: [id], onDelete: Cascade)

  @@id([retroPhaseId, columnId])
}

model RetroColumn {
  id            String                   @id @default(cuid())
  retroId       String
  title         String
  description   String?
  icon          String?
  logoUrl       String?
  position      Int
  retro         Retrospective            @relation(fields: [retroId], references: [id], onDelete: Cascade)
  cards         Card[]
  hiddenInPhases RetroPhaseHiddenColumn[]
}

model Participant {
  id             String         @id @default(cuid())
  retroId        String
  userId         String?
  guestName      String?
  avatarId       String?
  isGuest        Boolean        @default(false)
  commentsReady  Boolean        @default(false)
  votesReady     Boolean        @default(false)
  semaforoReady  Boolean        @default(false)
  retro          Retrospective  @relation(fields: [retroId], references: [id], onDelete: Cascade)
  user           User?          @relation(fields: [userId], references: [id])
  cards          Card[]
  votes          Vote[]
  reactions      CardReaction[]
  rotiResponses  RotiResponse[]
  semaforoVotes  SemaforoVote[]

  @@index([retroId, userId])
}

model Card {
  id               String        @id @default(cuid())
  retroId          String
  columnId         String
  authorId         String
  createdInPhaseId String?
  content          String        @default("")
  imageUrl         String?
  isAnonymous      Boolean       @default(false)
  groupId          String?
  position         Int           @default(0)
  createdAt        DateTime      @default(now())
  retro            Retrospective @relation(fields: [retroId], references: [id], onDelete: Cascade)
  column           RetroColumn   @relation(fields: [columnId], references: [id], onDelete: Cascade)
  author           Participant   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdInPhase   RetroPhase?   @relation(fields: [createdInPhaseId], references: [id], onDelete: SetNull)
  group            CardGroup?    @relation(fields: [groupId], references: [id], onDelete: SetNull)
  votes            Vote[]
  reactions        CardReaction[]
  actionItems      ActionItem[]
}

model CardGroup {
  id          String        @id @default(cuid())
  retroId     String
  title       String?
  retro       Retrospective @relation(fields: [retroId], references: [id], onDelete: Cascade)
  cards       Card[]
  votes       Vote[]
  actionItems ActionItem[]
}

model Vote {
  id            String        @id @default(cuid())
  retroId       String
  participantId String
  cardId        String?
  groupId       String?
  count         Int           @default(1)
  retro         Retrospective @relation(fields: [retroId], references: [id], onDelete: Cascade)
  participant   Participant   @relation(fields: [participantId], references: [id], onDelete: Cascade)
  card          Card?         @relation(fields: [cardId], references: [id], onDelete: Cascade)
  group         CardGroup?    @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([participantId, cardId])
  @@unique([participantId, groupId])
}

model CardReaction {
  id            String        @id @default(cuid())
  retroId       String
  cardId        String
  participantId String
  emoji         String
  retro         Retrospective @relation(fields: [retroId], references: [id], onDelete: Cascade)
  card          Card          @relation(fields: [cardId], references: [id], onDelete: Cascade)
  participant   Participant   @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([cardId, participantId, emoji])
  @@index([retroId])
}

model RetroSemaforoItem {
  id          String         @id @default(cuid())
  retroId     String
  title       String
  description String?
  position    Int
  note        String?
  retro       Retrospective  @relation(fields: [retroId], references: [id], onDelete: Cascade)
  votes       SemaforoVote[]
}

model SemaforoVote {
  id            String           @id @default(cuid())
  retroId       String
  itemId        String
  participantId String
  value         SemaforoValue
  retro         Retrospective    @relation(fields: [retroId], references: [id], onDelete: Cascade)
  item          RetroSemaforoItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  participant   Participant      @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([itemId, participantId])
  @@index([retroId])
}

model ActionItem {
  id              String                 @id @default(cuid())
  teamId          String
  retroId         String?
  title           String
  description     String?
  status          ActionStatus           @default(pending)
  ownerId         String?
  createdById     String?
  dueDate         DateTime?
  cardId          String?
  groupId         String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  team            Team                   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  retro           Retrospective?         @relation(fields: [retroId], references: [id], onDelete: SetNull)
  owner           User?                  @relation("ActionOwner", fields: [ownerId], references: [id])
  createdBy       User?                  @relation("ActionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  card            Card?                  @relation(fields: [cardId], references: [id], onDelete: SetNull)
  group           CardGroup?             @relation(fields: [groupId], references: [id], onDelete: SetNull)
  progressUpdates ActionProgressUpdate[]
}

model ActionProgressUpdate {
  id              String          @id @default(cuid())
  actionId        String
  authorId        String?
  sequence        Int
  title           String
  entryMode       ActionEntryMode
  entryModeCustom String?
  progress        String?
  pending         String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  action          ActionItem      @relation(fields: [actionId], references: [id], onDelete: Cascade)
  author          User?           @relation("ActionProgressAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@unique([actionId, sequence])
  @@index([actionId, createdAt])
}

model RotiResponse {
  id            String        @id @default(cuid())
  retroId       String
  participantId String
  score         Int
  comment       String?
  retro         Retrospective @relation(fields: [retroId], references: [id], onDelete: Cascade)
  participant   Participant   @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([retroId, participantId])
}
